# Copy to .env and fill in before running `npm run migrate` / `npm run seed` locally.
# On Vercel, set the same variables under Project Settings > Environment Variables.

# --- Database (required) ---
# Postgres connection string. Easiest: Vercel dashboard > Storage > Create Database
# > Postgres (Neon-backed), then copy the connection string it gives you.
# Or create one directly at https://neon.tech (free tier) and paste it here.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# --- AI provider (optional — add when you have a key) ---
# One of: openai | anthropic | google
AI_PROVIDER=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# Optional: override the default model for the chosen provider
AI_MODEL=

# --- Web search provider (optional — add when you have a key) ---
# One of: tavily | serper | bing
# Tavily is recommended (built for AI/LLM search, has a free tier): https://tavily.com
SEARCH_PROVIDER=
TAVILY_API_KEY=
SERPER_API_KEY=
BING_API_KEY=
